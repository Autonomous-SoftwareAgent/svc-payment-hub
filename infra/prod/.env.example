# Sao thành .env trên MÁY CHỦ (chmod 600). KHÔNG commit .env, KHÔNG điền giá trị thật vào file này.

# --- Triển khai ---
# Image Hub, tag bất biến do scripts/deploy.ps1 ghi; vd <user>/bsn:hub-20261002-101500
HUB_IMAGE=
# Tên miền công khai (DNS A/AAAA đã trỏ về VM, mở 80/443)
HUB_DOMAIN=
# (tùy chọn) Chỉ cho các CIDR này gọi API cửa hàng/vận hành, cách nhau bằng dấu cách. Để trống = không giới hạn IP.
HUB_ADMIN_ALLOW_CIDR=
# (tùy chọn) Cổng công bố trên máy chủ, mặc định 80/443
HUB_HTTP_PORT=
HUB_HTTPS_PORT=

# --- Bí mật ---
# Mật khẩu PostgreSQL; dùng chuỗi hex/chữ-số (openssl rand -hex 24) vì được ghép vào URL
POSTGRES_PASSWORD=
# Token Bearer cho API cửa hàng/vận hành (openssl rand -hex 32)
HUB_API_TOKEN=
# (tùy chọn) Token cũ, chỉ đặt trong lúc xoay vòng token (xem README); xóa sau khi mọi nơi gọi đã đổi
HUB_API_TOKEN_PREVIOUS=
# (tùy chọn) Token riêng cho Prometheus đọc /metrics; để trống thì dùng token quản trị
HUB_METRICS_TOKEN=
# (tùy chọn) Webhook Hub -> cửa hàng mặc định; để trống cả hai thì tắt. Nhiều cửa hàng: khai báo shops[] trong hub.config.json
SHOP_WEBHOOK_URL=
SHOP_WEBHOOK_SECRET=

# --- Cổng thanh toán (chỉ cần cho cổng có enabled=true trong hub.config.json) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ONEPAY_MERCHANT=
ONEPAY_ACCESS_CODE=
ONEPAY_HASH_KEY_HEX=
ONEPAY_QUERY_USER=
ONEPAY_QUERY_PASSWORD=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_HMAC_SECRET=
SEPAY_API_TOKEN=
