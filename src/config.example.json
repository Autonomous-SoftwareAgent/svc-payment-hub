{
  "port": 8080,
  "host": "127.0.0.1",
  "publicBaseUrl": "${HUB_PUBLIC_BASE_URL}",
  "apiToken": "${HUB_API_TOKEN}",
  "databaseUrl": "${HUB_DATABASE_URL}",
  "schedulerSeconds": 30,
  "metricsToken": "${HUB_METRICS_TOKEN:-}",
  "shops": [
    { "id": "shop1", "apiToken": "${SHOP1_API_TOKEN}", "webhooks": { "url": "${SHOP1_WEBHOOK_URL}", "secret": "${SHOP1_WEBHOOK_SECRET}" } }
  ],
  "limits": { "maxInFlight": 1000, "callbackReserve": 200, "ratePerSecond": 200, "burst": 400 },
  "hub": {
    "paymentTtlSeconds": 1800,
    "maxAmount": 1000000000000,
    "failover": { "enabled": true, "maxAttempts": 3, "skipOnFailCodes": [] },
    "reconcile": {
      "firstAfterSeconds": 60, "backoffSeconds": [60, 120, 300, 600, 1800], "maxAgeSeconds": 86400, "concurrency": 10,
      "refundBackoffSeconds": [60, 300, 1800, 7200, 21600, 43200, 86400],
      "closedRecheckSeconds": [3600, 86400],
      "perGateway": { "sepay": { "firstAfterSeconds": 30, "backoffSeconds": [30, 60, 300] }, "stripe": { "maxAgeSeconds": 864000 } }
    },
    "refund": { "maxPerAttempt": 10, "maxAgeDays": 365 },
    "protection": { "timeoutMs": 15000, "maxConcurrent": 100, "maxQueue": 400, "failureThreshold": 5, "openSeconds": 30, "perGateway": {} },
    "webhooks": { "url": "${SHOP_WEBHOOK_URL:-}", "secret": "${SHOP_WEBHOOK_SECRET:-}" },
    "hot": { "idleSeconds": 120, "evictEverySeconds": 10, "seenTtlDays": 90 },
    "gateways": [
      { "id": "vnpay", "priority": 1, "methods": ["card_domestic", "qr"] },
      { "id": "momo", "priority": 2 },
      { "id": "onepay", "priority": 3, "enabled": false },
      { "id": "sepay", "priority": 4, "enabled": false },
      { "id": "stripe", "priority": 5, "enabled": false, "currencies": ["USD", "EUR", "JPY", "VND"] },
      { "id": "paypal", "priority": 6, "enabled": false, "currencies": ["USD", "EUR", "JPY"] }
    ]
  },
  "adapters": {
    "vnpay": { "tmnCode": "${VNPAY_TMN_CODE}", "hashSecret": "${VNPAY_HASH_SECRET}", "baseUrl": "https://sandbox.vnpayment.vn" },
    "momo": { "partnerCode": "${MOMO_PARTNER_CODE}", "accessKey": "${MOMO_ACCESS_KEY}", "secretKey": "${MOMO_SECRET_KEY}", "baseUrl": "https://test-payment.momo.vn" },
    "onepay": { "merchant": "${ONEPAY_MERCHANT}", "accessCode": "${ONEPAY_ACCESS_CODE}", "hashKeyHex": "${ONEPAY_HASH_KEY_HEX}", "queryUser": "${ONEPAY_QUERY_USER}", "queryPassword": "${ONEPAY_QUERY_PASSWORD}", "baseUrl": "https://mtf.onepay.vn" },
    "sepay": { "accountNumber": "${SEPAY_ACCOUNT_NUMBER}", "bankName": "${SEPAY_BANK_NAME}", "accountName": "${SEPAY_ACCOUNT_NAME}", "codePrefix": "DH", "authMode": "hmac", "hmacSecret": "${SEPAY_HMAC_SECRET}", "apiToken": "${SEPAY_API_TOKEN}",
      "defaultProduct": "qr-static",
      "va": { "bankAccountId": "${SEPAY_VA_BANK_ACCOUNT_ID}", "durationSeconds": 1800 },
      "pg": { "merchantId": "${SEPAY_PG_MERCHANT_ID}", "secretKey": "${SEPAY_PG_SECRET_KEY}" } },
    "stripe": { "secretKey": "${STRIPE_SECRET_KEY}", "webhookSecret": "${STRIPE_WEBHOOK_SECRET}", "product": "charge", "sessionExpiresMinutes": 60, "currencies": ["USD", "EUR", "JPY", "VND"] },
    "paypal": { "clientId": "${PAYPAL_CLIENT_ID}", "clientSecret": "${PAYPAL_CLIENT_SECRET}", "webhookId": "${PAYPAL_WEBHOOK_ID}", "product": "charge", "baseUrl": "https://api-m.sandbox.paypal.com", "currencies": ["USD", "EUR", "JPY"] }
  }
}
